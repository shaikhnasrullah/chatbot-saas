# Is file ko ".env" naam se copy karo aur values bharo.

# Clip selection + translation ke liye (https://console.anthropic.com se key)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Speech-to-text: tiny / base / small / medium / large-v3  (bada = accurate lekin slow)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE=auto

# Limits
MAX_VIDEO_MINUTES=60
WORKERS=1
KEEP_SOURCE=0

# Hindi/Devanagari captions ke liye koi Unicode font jaise "Noto Sans Devanagari" install karo
CAPTION_FONT=Arial
# CAPTION_FONTS_DIR=fonts

# Agar YouTube "sign in to confirm you're not a bot" bole to browser se cookies.txt export karke path do
# YTDLP_COOKIES=cookies.txt
